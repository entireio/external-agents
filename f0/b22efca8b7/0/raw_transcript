161\t  });\n162\t\n163\t  pi.on(\"turn_end\", async (event, ctx) => {\n164\t    capture(\"turn_end\", {\n165\t      type: \"turn_end\",\n166\t      cwd: ctx.cwd,\n167\t      session_file: ctx.sessionManager.getSessionFile(),\n168\t      turn_index: event.turnIndex,\n169\t    });\n170\t  });\n171\t\n172\t  pi.on(\"agent_end\", async (event, ctx) => {\n173\t    capture(\"agent_end\", {\n174\t      type: \"agent_end\",\n175\t      cwd: ctx.cwd,\n176\t      session_file: ctx.sessionManager.getSessionFile(),\n177\t      message_count: event.messages.length,\n178\t    });\n179\t  });\n180\t\n181\t  pi.on(\"session_shutdown\", async (_event) => {\n182\t    capture(\"session_shutdown\", {\n183\t      type: \"session_shutdown\",\n184\t    });\n185\t  });\n186\t}\n187\tEXTENSION_EOF\n188\t\n189\techo \"  Extension installed at: $EXT_DIR/index.ts\"\n190\techo \"\"\n191\t\n192\t# ──────────────────────────────────────────────\n193\t# Section 3: Run Modes\n194\t# ──────────────────────────────────────────────\n195\t\n196\tif [[ \"$MODE\" == \"auto\" ]]; then\n197\t  echo \"=== Automated Run ===\"\n198\t  echo \"  Running: $RUN_CMD\"\n199\t  echo \"\"\n200\t  cd \"$TEST_REPO\"\n201\t  ENTIRE_PROBE_CAPTURE_DIR=\"$CAPTURE_DIR\" eval \"$RUN_CMD\" || true\n202\t  cd - > /dev/null\n203\telif [[ \"$MODE\" == \"manual\" ]]; then\n204\t  echo \"=== Manual Live Mode ===\"\n205\t  echo \"  Test repo: $TEST_REPO\"\n206\t  echo \"  Run pi in the test repo with:\"\n207\t  echo \"\"\n208\t  echo \"    cd $TEST_REPO && ENTIRE_PROBE_CAPTURE_DIR=$CAPTURE_DIR pi\"\n209\t  echo \"\"\n210\t  echo \"  Send a few prompts, then exit pi (Ctrl+C or Ctrl+D).\"\n211\t  echo \"  Press Enter here when done...\"\n212\t  read -r\n213\telse\n214\t  echo \"=== Skipping run (no mode selected) ===\"\n215\t  echo \"  Use --run-cmd or --manual-live to capture payloads\"\n216\tfi\n217\t\n218\techo \"\"\n219\t\n220\t# ──────────────────────────────────────────────\n221\t# Section 4: Capture Collection\n222\t# ────────