oolCalls) > 0 {\n1054\t\t\ttoolUseJSON, err := json.Marshal(kiroToolUseContent{\n1055\t\t\t\tToolUse: kiroToolUsePayload{ToolUses: toolCalls},\n1056\t\t\t})\n1057\t\t\tif err == nil {\n1058\t\t\t\tentries = append(entries, kiroHistoryEntry{Assistant: toolUseJSON})\n1059\t\t\t}\n1060\t\t}\n1061\t\n1062\t\treturn entries\n1063\t}\n1064\t\n1065\t// enrichIDETranscriptWithExecutionLogs converts an IDE transcript to CLI\n1066\t// format and replaces \"On it.\" assistant entries with actual data from\n1067\t// execution logs. Returns the re-serialized CLI-format JSON, or nil if\n1068\t// conversion fails.\n1069\tfunc enrichIDETranscriptWithExecutionLogs(ideData []byte, execLogs map[string]*kiroExecutionLog) []byte {\n1070\t\tvar meta kiroIDESessionMeta\n1071\t\tif err := json.Unmarshal(ideData, &meta); err != nil {\n1072\t\t\treturn nil\n1073\t\t}\n1074\t\tif len(meta.History) == 0 {\n1075\t\t\treturn nil\n1076\t\t}\n1077\t\n1078\t\t// Convert to CLI format, enriching assistant entries from execution logs.\n1079\t\t// kiroIDEHistoryMeta contains both the Message (for pairing) and the\n1080\t\t// ExecutionID (for matching against execution logs).\n1081\t\ttranscript := &kiroTranscript{}\n1082\t\tvar pendingUser *kiroIDEHistoryEntry\n1083\t\tfor i := range meta.History {\n1084\t\t\t// Adapt meta entry to IDE entry (they share the same Message field)\n1085\t\t\tideEntry := &kiroIDEHistoryEntry{Message: meta.History[i].Message}\n1086\t\t\tswitch ideEntry.Message.Role {\n1087\t\t\tcase \"user\":\n1088\t\t\t\tif pendingUser != nil {\n1089\t\t\t\t\ttranscript.History = append(transcript.History, ideEntryToPaired(pendingUser, nil))\n1090\t\t\t\t}\n1091\t\t\t\tpendingUser = ideEntry\n1092\t\t\tcase \"assistant\":\n1093\t\t\t\tif execID := meta.History[i].ExecutionID; execID != \"\" {\n1094\t\t\t\t\tif execLog, ok := execLogs[execID]; ok {\n1095\t\t\t\t\t\tuserEntry := ideEntryToPaired(pendingUser, nil)\n1096\t\t\t\t\t\tassistantEntries := convertExecutionActionsToHistoryEntries(ex