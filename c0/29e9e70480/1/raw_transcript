y) == 0 {\n257\t\t\treturn \"\", errors.New(\"CLI transcript has no history entries\")\n258\t\t}\n259\t\n260\t\tif err := os.WriteFile(cachePath, data, 0o600); err != nil {\n261\t\t\treturn \"\", fmt.Errorf(\"failed to write cached transcript: %w\", err)\n262\t\t}\n263\t\treturn cachePath, nil\n264\t}\n265\t\n266\ttype transcriptOffset struct {\n267\t\tConversationID string `json:\"conversation_id\"`\n268\t\tPosition       int    `json:\"position\"`\n269\t}\n270\t\n271\tfunc (a *Agent) transcriptOffsetPath() string {\n272\t\treturn filepath.Join(protocol.RepoRoot(), \".entire\", \"tmp\", \"kiro-transcript-offset.json\")\n273\t}\n274\t\n275\tfunc readTranscriptOffset(path string) transcriptOffset {\n276\t\tdata, err := os.ReadFile(path)\n277\t\tif err != nil {\n278\t\t\treturn transcriptOffset{}\n279\t\t}\n280\t\tvar offset transcriptOffset\n281\t\tif err := json.Unmarshal(data, &offset); err != nil {\n282\t\t\treturn transcriptOffset{}\n283\t\t}\n284\t\treturn offset\n285\t}\n286\t\n287\tfunc writeTranscriptOffset(path string, offset transcriptOffset) error {\n288\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n289\t\t\treturn err\n290\t\t}\n291\t\tdata, err := json.Marshal(offset)\n292\t\tif err != nil {\n293\t\t\treturn err\n294\t\t}\n295\t\treturn os.WriteFile(path, data, 0o600)\n296\t}\n297\t\n298\t// trimTranscriptHistory trims already-checkpointed entries from a cumulative\n299\t// kiro transcript using a stored offset. Returns the re-serialized trimmed\n300\t// JSON and true if trimming was applied, or (nil, false) if the full\n301\t// transcript should be used as-is.\n302\tfunc (a *Agent) trimTranscriptHistory(raw []byte) ([]byte, bool) {\n303\t\tparsed, err := parseTranscript(raw)\n304\t\tif err != nil || len(parsed.History) == 0 {\n305\t\t\treturn nil, false\n306\t\t}\n307\t\n308\t\toffsetPath := a.transcriptOffsetPath()\n309\t\tprev := readTranscriptOffset(offsetPath)\n310\t\ttotalLen := len(parsed.History)\n311\t\n312\t\ttrimFrom := 0\n313\t\tif prev.ConversationID == parsed.ConversationID && prev.Position > 0 && prev.Position <= totalLen {\n314\t\t\ttrimFrom = prev.Position\n315\t\t}\n316\t\n317\t\t// Only update offset when there are new entries to capture.\n318\t\tif trimFrom < totalLen {\n319\t\t\t_ = writeTranscriptOffset(offsetPath, transcriptOffset{\n320\t\t\t\tConversationID: parsed.ConversationID,\n321\t\t\t\tPosition:       totalLen,\n322\t\t\t})\n323\t\t}\n324\t\n325\t\tif trimFrom == 0 || trimFrom >= totalLen {\n326\t\t\t// No trimming needed (first capture) or no new entries since last\n327\t\t\t// capture. Return full transcript so the caller always has content —\n328\t\t\t// an empty transcript would cause the CLI finalize step to fail.\n329\t\t\treturn nil, false\n330\t\t}\n331\t\n332\t\tparsed.History = parsed.History[trimFrom:]\n333\t\tfiltered, err := json.Marshal(parsed)\n334\t\tif err != nil {\n335\t\t\treturn nil, false\n336\t\t}\n337\t\treturn filtered, true\n338\t}\n339\t\n340\tfunc (a *Agent) ensureIDETranscript(cwd string, sessionID string) (string, error) {\n341\t\tsessionsDir, err := ideWorkspaceSessionsDir(cwd)\n342\t\tif err != nil {\n343\t\t\treturn \"\", err\n344\t\t}\n345\t\tideSessionID, err := latestIDESessionID(cwd)\n346\t\tif err != nil {\n347\t\t\treturn \"\", err\n348\t\t}\n349\t\tif !filepath.IsLocal(ideSessionID + \".json\") {\n350\t\t\treturn \"\", fmt.Errorf(\"invalid session ID: %q\", ideSessionID)\n351\t\t}\n352\t\n353\t\ttranscriptPath := filepath.Join(sessionsDir, ideSessionID+\".json\")\n354\t\ttranscriptData, err := os.ReadFile(transcriptPath)\n355\t\tif err != nil {\n356\t\t\treturn \"\", fmt.Errorf(\"failed to read IDE transcript %s: %w\", transcriptPath, err)\n357\t\t}\n358\t\n359\t\t// Enrich the IDE transcript with actual agent responses and tool calls.\n360\t\t// The IDE session format only stores \"On it.\" as assistant content.\n361\t\t//\n362\t\t// Priority 1: Read Kiro IDE execution logs — these contain the full\n363\t\t// action trace (tool calls, responses, file modifications).\n364\t\t// Priority 2: Merge tool calls from post-tool-use hook JSONL file.\n365\t\tdata := transcriptData\n366\t\tenriched := false\n367\t\tif chatSessionID := extractIDESessionID(transcriptData); chatSessionID != \"\" {\n368\t\t\tif execLogs, err := findExecutionLogsForSession(chatSessionID); err == nil && len(execLogs) > 0 {\n369\t\t\t\tif result := enrichIDETranscriptWithExecutionLogs(transcriptData, execLogs); result != nil {\n370\t\t\t\t\tdata = result\n371\t\t\t\t\tenriched = true\n372\t\t\t\t}\n373\t\t\t}\n374\t\t}\n375\t\tif !enriched {\n376\t\t\tif toolCalls := a.readAndClearToolCalls(); len(toolCalls) > 0 {\n377\t\t\t\tif result := enrichIDETranscriptWithToolCalls(transcriptData, toolCalls); result != nil {\n378\t\t\t\t\tdata = result\n379\t\t\t\t}\n380\t\t\t}\n381\t\t}\n382\t\n383\t\t// Trim already-checkpointed entries from cumulative IDE transcript.\n384\t\tif filtered, ok := a.trimTranscriptHistory(data); ok {\n385\t\t\tdata = filtered\n386\t\t}\n387\t\tdata = injectTranscriptCLIVersion(data, currentCLIVersion())\n388\t\n389\t\tif parsed, parseErr := parseTranscript(data); parseErr == nil && len(parsed.History) == 0 {\n390\t\t\treturn \"\", errors.New(\"IDE transcript has no history entries after trimming\")\n391\t\t}\n392\t\n393\t\tcachePath, err := a.cacheTranscriptPath(cwd, sessionID)\n394\t\tif err != nil {\n395\t\t\treturn \"\", err\n396\t\t}\n397\t\tif err := os.WriteFile(cachePath, data, 0o600); err != nil {\n398\t\t\treturn \"\", fmt.Errorf(\"failed to write cached IDE transcript: %w\", err)\n399\t\t}\n400\t\treturn cachePath, nil\n401\t}\n402\t\n403\t// enrichIDETranscriptWithToolCalls converts an IDE transcript to CLI format\n404\t// and injects the captured tool calls into the last assistant entry. Returns\n405\t// the re-serialized CLI-format JSON, or nil if conversion fails.\n406\tfunc enrichIDETranscriptWithToolCalls(ideData []byte, toolCalls []kiroToolCall) []byte {\n407\t\tconverted := tryParseIDETranscript(ideData)\n408\t\tif converted == nil || len(converted.History) == 0 {\n409\t\t\treturn nil\n410\t\t}\n411\t\n412\t\t// Assign all tool calls to the last assistant entry, since post-tool-use\n413\t\t// hooks fire between user-prompt-submit and stop for the current turn.\n414\t\ttoolUse := kiroToolUseContent{\n415\t\t\tToolUse: kiroToolUsePayload{ToolUses: toolCalls},\n416\t\t}\n417\t\ttoolUseJSON, err := json.Marshal(toolUse)\n418\t\tif err != nil {\n419\t\t\treturn nil\n420\t\t}\n421\t\n422\t\tlastIdx := len(converted.History) - 1\n423\t\tconverted.History[lastIdx].Assistant = toolUseJSON\n424\t\n425\t\tresult, err := json.Marshal(converted)\n426\t\tif err != nil {\n427\t\t\treturn nil\n428\t\t}\n429\t\treturn result\n430\t}\n431\t\n432\tfunc (a *Agent) captureTranscriptForStop(cwd string, sessionID string, conversationID string) string {\n433\t\t// Try IDE workspace sessions first — the stop hook is fired by the IDE,\n434\t\t// so IDE data is the most accurate source. CLI DB is a fallback for\n435\t\t// kiro-cli (non-IDE) sessions where no IDE workspace data exists.\n436\t\tif sessionRef, err := a.ensureIDETranscript(cwd, sessionID); err == nil && sessionRef != \"\" {\n437\t\t\treturn sessionRef\n438\t\t}\n439\t\tif sessionRef, err := a.ensureCachedTranscript(cwd, sessionID, conversationID); err == nil && sessionRef != \"\" {\n440\t\t\treturn sessionRef\n441\t\t}\n442\t\treturn a.createPlaceholderTranscript(cwd, sessionID)\n443\t}\n444\t\n445\tfunc (a *Agent) createPlaceholderTranscript(cwd string, sessionID string) string {\n446\t\tcachePath, err := a.cacheTranscriptPath(cwd, sessionID)\n447\t\tif err != nil {\n448\t\t\treturn \"\"\n449\t\t}\n450\t\tif err := os.WriteFile(cachePath, []byte(\"{}\"), 0o600); err != nil {\n451\t\t\treturn \"\"\n452\t\t}\n453\t\treturn cachePath\n454\t}\n455\t\n456\tfunc (a *Agent) cacheTranscriptPath(cwd string, sessionID string) (string, error) {\n457\t\trepoRoot := protocol.RepoRoot()\n458\t\tif repoRoot == \"\" {\n459\t\t\trepoRoot = cwd\n460\t\t}\n461\t\tsessionDir, err := a.GetSessionDir(repoRoot)\n462\t\tif err != nil {\n463\t\t\treturn \"\", err\n464\t\t}\n465\t\tif err := os.MkdirAll(sessionDir, 0o700); err != nil {\n466\t\t\treturn \"\", fmt.Errorf(\"failed to create cache dir: %w\", err)\n467\t\t}\n468\t\treturn a.ResolveSessionFile(sessionDir, sessionID), nil\n469\t}\n470\t\n471\tfunc kiroDataDir() (string, error) {\n472\t\thome, err := userHomeDir()\n473\t\tif err != nil {\n474\t\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n475\t\t}\n476\t\tswitch runtimeGOOS {\n477\t\tcase \"darwin\":\n478\t\t\treturn filepath.Join(home, \"Library\", \"Application Support\"), nil\n479\t\tcase \"windows\":\n480\t\t\tlocalAppData := os.Getenv(\"LOCALAPPDATA\")\n481\t\t\tif localAppData == \"\" {\n482\t\t\t\tlocalAppData = filepath.Join(home, \"AppData\", \"Local\")\n483\t\t\t}\n484\t\t\treturn localAppData, nil\n485\t\tdefault:\n486\t\t\treturn filepath.Join(home, \".local\", \"share\"), nil\n487\t\t}\n488\t}\n489\t\n490\tfunc kiroCLIDataDBPath() (string, error) {\n491\t\tdataDir, err := kiroDataDir()\n492\t\tif err != nil {\n493\t\t\treturn \"\", err\n494\t\t}\n495\t\treturn filepath.Join(dataDir, \"kiro-cli\", \"data.sqlite3\"), nil\n496\t}\n497\t\n498\t// kiroExtensionStorageDir returns the platform-specific base directory for\n499\t// Kiro IDE extension data (workspace sessions, execution logs, etc.).\n500\tfunc kiroExtensionStorageDir() (string, error) {\n501\t\thome, err := userHomeDir()\n502\t\tif err != nil {\n503\t\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n504\t\t}\n505\t\tswitch runtimeGOOS {\n506\t\tcase \"darwin\":\n507\t\t\treturn filepath.Join(home, \"Library\", \"Application Support\", \"Kiro\", \"User\", \"globalStorage\", \"kiro.kiroagent\"), nil\n508\t\tcase \"windows\":\n509\t\t\tappData := os.Getenv(\"APPDATA\")\n510\t\t\tif appData == \"\" {\n511\t\t\t\tappData = filepath.Join(home, \"AppData\", \"Roaming\")\n512\t\t\t}\n513\t\t\treturn filepath.Join(appData, \"Kiro\", \"User\", \"globalStorage\", \"kiro.kiroagent\"), nil\n514\t\tdefault:\n515\t\t\treturn filepath.Join(home, \".config\", \"Kiro\", \"User\", \"globalStorage\", \"kiro.kiroagent\"), nil\n516\t\t}\n517\t}\n518\t\n519\tfunc latestIDESessionID(cwd string) (string, error) {\n520\t\tsessionsDir, err := ideWorkspaceSessionsDir(cwd)\n521\t\tif err != nil {\n522\t\t\treturn \"\", err\n523\t\t}\n524\t\n525\t\tindexPath := filepath.Join(sessionsDir, \"sessions.json\")\n526\t\tindexData, err := os.ReadFile(indexPath)\n527\t\tif err != nil {\n528\t\t\treturn \"\", fmt.Errorf(\"IDE sessions.json not found: %w\", err)\n529\t\t}\n530\t\n531\t\tvar sessions []ideSessionIndexEntry\n532\t\tif err := json.Unmarshal(indexData, &sessions); err != nil {\n533\t\t\treturn \"\", fmt.Errorf(\"failed to parse IDE sessions.json: %w\", err)\n534\t\t}\n535\t\tif len(sessions) == 0 {\n536\t\t\treturn \"\", errors.New(\"no IDE sessions found\")\n537\t\t}\n538\t\n539\t\tsort.Slice(sessions, func(i, j int) bool {\n540\t\t\treturn sessions[i].DateCreated > sessions[j].DateCreated\n541\t\t})\n542\t\n543\t\tif sessions[0].SessionID == \"\" {\n544\t\t\treturn \"\", errors.New(\"latest IDE session is missing sessionId\")\n545\t\t}\n546\t\treturn sessions[0].SessionID, nil\n547\t}\n548\t\n549\tfunc ideWorkspaceSessionsDir(cwd string) (string, error) {\n550\t\tbaseDir, err := kiroExtensionStorageDir()\n551\t\tif err != nil {\n552\t\t\treturn \"\", err\n553\t\t}\n554\t\t// Kiro IDE uses standard base64 with '=' padding replaced by '_'.\n555\t\tencoded := strings.ReplaceAll(base64.StdEncoding.EncodeToString([]byte(cwd)), \"=\", \"_\")\n556\t\treturn filepath.Join(baseDir, \"workspace-sessions\", encoded), nil\n557\t}\n558\t\n559\tfunc escapeSQLString(s string) string {\n560\t\treturn strings.ReplaceAll(s, \"'\", \"''\")\n561\t}\n562\t\n563\tfunc (a *Agent) GetTranscriptPosition(path string) (int, error) {\n564\t\ttranscript, err := readAndParseTranscript(path)\n565\t\tif errors.Is(err, os.ErrNotExist) {\n566\t\t\treturn 0, nil\n567\t\t}\n568\t\tif err != nil {\n569\t\t\treturn 0, err\n570\t\t}\n571\t\treturn len(transcript.History), nil\n572\t}\n573\t\n574\tfunc (a *Agent) ExtractModifiedFiles(path string, offset int) ([]string, int, error) {\n575\t\ttranscript, err := readAndParseTranscript(path)\n576\t\tif errors.Is(err, os.ErrNotExist) {\n577\t\t\treturn nil, 0, nil\n578\t\t}\n579\t\tif err != nil {\n580\t\t\treturn nil, 0, err\n581\t\t}\n582\t\n583\t\ttotalEntries := len(transcript.History)\n584\t\tif offset >= totalEntries {\n585\t\t\treturn nil, totalEntries, nil\n586\t\t}\n587\t\n588\t\treturn extractModifiedFilesFromHistory(transcript.History[offset:]), totalEntries, nil\n589\t}\n590\t\n591\tfunc (a *Agent) ExtractPrompts(path string, offset int) ([]string, error) {\n592\t\ttranscript, err := readAndParseTranscript(path)\n593\t\tif errors.Is(err, os.ErrNotExist) {\n594\t\t\treturn nil, nil\n595\t\t}\n596\t\tif err != nil {\n597\t\t\treturn nil, err\n598\t\t}\n599\t\n600\t\tvar prompts []string\n601\t\tfor i := offset; i < len(transcript.History); i++ {\n602\t\t\tif prompt := extractUserPrompt(transcript.History[i].User.Content); prompt != \"\" {\n603\t\t\t\tprompts = append(prompts, prompt)\n604\t\t\t}\n605\t\t}\n606\t\treturn prompts, nil\n607\t}\n608\t\n609\tfunc (a *Agent) ExtractSummary(path string) (string, bool, error) {\n610\t\ttranscript, err := readAndParseTranscript(path)\n611\t\tif errors.Is(err, os.ErrNotExist) {\n612\t\t\treturn \"\", false, nil\n613\t\t}\n614\t\tif err != nil {\n615\t\t\treturn \"\", false, err\n616\t\t}\n617\t\n618\t\tsummary := extractLastAssistantResponse(transcript.History)\n619\t\treturn summary, summary != \"\", nil\n620\t}\n621\t\n622\tfunc readAndParseTranscript(path string) (*kiroTranscript, error) {\n623\t\tdata, err := os.ReadFile(path)\n624\t\tif err != nil {\n625\t\t\treturn nil, err\n626\t\t}\n627\t\treturn parseTranscript(data)\n628\t}\n629\t\n630\tfunc parseTranscript(data []byte) (*kiroTranscript, error) {\n631\t\tif len(data) == 0 {\n632\t\t\treturn &kiroTranscript{}, nil\n633\t\t}\n634\t\n635\t\tvar transcript kiroTranscript\n636\t\tif err := json.Unmarshal(data, &transcript); err != nil {\n637\t\t\treturn nil, fmt.Errorf(\"failed to parse kiro transcript: %w\", err)\n638\t\t}\n639\t\tif isCLITranscript(&transcript) {\n640\t\t\treturn &transcript, nil\n641\t\t}\n642\t\n643\t\tif converted := tryParseIDETranscript(data); converted != nil {\n644\t\t\treturn converted, nil\n645\t\t}\n646\t\n647\t\treturn &transcript, nil\n648\t}\n649\t\n650\tfunc isCLITranscript(transcript *kiroTranscript) bool {\n651\t\tif len(transcript.History) == 0 {\n652\t\t\treturn false\n653\t\t}\n654\t\treturn len(transcript.History[0].User.Content) > 0 || len(transcript.History[0].Assistant) > 0\n655\t}\n656\t\n657\tfunc tryParseIDETranscript(data []byte) *kiroTranscript {\n658\t\tvar ide kiroIDETranscript\n659\t\tif err := json.Unmarshal(data, &ide); err != nil {\n660\t\t\treturn nil\n661\t\t}\n662\t\tif len(ide.History) == 0 || ide.History[0].Message.Role == \"\" {\n663\t\t\treturn nil\n664\t\t}\n665\t\treturn convertIDETranscript(&ide)\n666\t}\n667\t\n668\tfunc convertIDETranscript(ide *kiroIDETranscript) *kiroTranscript {\n669\t\ttranscript := &kiroTranscript{CLIVersion: ide.CLIVersion}\n670\t\n671\t\tvar pendingUser *kiroIDEHistoryEntry\n672\t\tfor i := range ide.History {\n673\t\t\tentry := &ide.History[i]\n674\t\t\tswitch entry.Message.Role {\n675\t\t\tcase \"user\":\n676\t\t\t\tif pendingUser != nil {\n677\t\t\t\t\ttranscript.History = append(transcript.History, ideEntryToPaired(pendingUser, nil))\n678\t\t\t\t}\n679\t\t\t\tpendingUser = entry\n680\t\t\tcase \"assistant\":\n681\t\t\t\ttranscript.History = append(transcript.History, ideEntryToPaired(pendingUser, entry))\n682\t\t\t\tpendingUser = nil\n683\t\t\t}\n684\t\t}\n685\t\n686\t\tif pendingUser != nil {\n687\t\t\ttranscript.History = append(transcript.History, ideEntryToPaired(pendingUser, nil))\n688\t\t}\n689\t\n690\t\treturn transcript\n691\t}\n692\t\n693\tfunc currentCLIVersion() string {\n694\t\treturn strings.TrimSpace(os.Getenv(\"ENTIRE_CLI_VERSION\"))\n695\t}\n696\t\n697\tfunc injectTranscriptCLIVersion(data []byte, version string) []byte {\n698\t\tif len(data) == 0 || version == \"\" {\n699\t\t\treturn data\n700\t\t}\n701\t\n702\t\tvar transcript kiroTranscript\n703\t\tif err := json.Unmarshal(data, &transcript); err == nil {\n704\t\t\tif transcript.CLIVersion != \"\" {\n705\t\t\t\treturn data\n706\t\t\t}\n707\t\t\tif transcript.ConversationID != \"\" || isCLITranscript(&transcript) {\n708\t\t\t\ttranscript.CLIVersion = version\n709\t\t\t\tif encoded, err := json.Marshal(transcript); err == nil {\n710\t\t\t\t\treturn encoded\n711\t\t\t\t}\n712\t\t\t\treturn data\n713\t\t\t}\n714\t\t}\n715\t\n716\t\tvar ide kiroIDETranscript\n717\t\tif err := json.Unmarshal(data, &ide); err == nil {\n718\t\t\tif ide.CLIVersion != \"\" || len(ide.History) == 0 {\n719\t\t\t\treturn data\n720\t\t\t}\n721\t\t\tide.CLIVersion = version\n722\t\t\tif encoded, err := json.Marshal(ide); err == nil {\n723\t\t\t\treturn encoded\n724\t\t\t}\n725\t\t}\n726\t\n727\t\treturn data\n728\t}\n729\t\n730\tfunc ideEntryToPaired(user, assistant *kiroIDEHistoryEntry) kiroHistoryEntry {\n731\t\tentry := kiroHistoryEntry{}\n732\t\n733\t\tif user != nil {\n734\t\t\tprompt := extractIDEText(user.Message.Content, true)\n735\t\t\tif prompt != \"\" {\n736\t\t\t\tcontent, err := json.Marshal(kiroPromptContent{\n737\t\t\t\t\tPrompt: struct {\n738\t\t\t\t\t\tPrompt string `json:\"prompt\"`\n739\t\t\t\t\t}{Prompt: prompt},\n740\t\t\t\t})\n741\t\t\t\tif err == nil {\n742\t\t\t\t\tentry.User.Content = content\n743\t\t\t\t}\n744\t\t\t} else {\n745\t\t\t\tentry.User.Content = user.Message.Content\n746\t\t\t}\n747\t\t}\n748\t\n749\t\tif assistant != nil {\n750\t\t\ttext := extractIDEText(assistant.Message.Content, false)\n751\t\t\tif text != \"\" {\n752\t\t\t\tcontent, err := json.Marshal(kiroResponseContent{\n753\t\t\t\t\tResponse: kiroResponsePayload{Content: text},\n754\t\t\t\t})\n755\t\t\t\tif err == nil {\n756\t\t\t\t\tentry.Assistant = content\n757\t\t\t\t}\n758\t\t\t} else {\n759\t\t\t\tentry.Assistant = assistant.Message.Content\n760\t\t\t}\n761\t\t}\n762\t\n763\t\treturn entry\n764\t}\n765\t\n766\t// extractIDEText extracts text from a json.RawMessage that may be either a\n767\t// plain string or an array of content blocks. When blocksFirst is true, it\n768\t// tries to parse as blocks before falling back to a plain string (user\n769\t// messages); otherwise it tries plain string first (assistant messages).\n770\tfunc extractIDEText(content json.RawMessage, blocksFirst bool) string {\n771\t\tif len(content) == 0 {\n772\t\t\treturn \"\"\n773\t\t}\n774\t\n775\t\ttryBlocks := func() string {\n776\t\t\tvar blocks []kiroIDEContentBlock\n777\t\t\tif err := json.Unmarshal(content, &blocks); err == nil && len(blocks) > 0 {\n778\t\t\t\tfor _, block := range blocks {\n779\t\t\t\t\tif block.Type == \"text\" && block.Text != \"\" {\n780\t\t\t\t\t\treturn block.Text\n781\t\t\t\t\t}\n782\t\t\t\t}\n783\t\t\t}\n784\t\t\treturn \"\"\n785\t\t}\n786\t\n787\t\ttryString := func() string {\n788\t\t\tvar text string\n789\t\t\tif err := json.Unmarshal(content, &text); err == nil {\n790\t\t\t\treturn text\n791\t\t\t}\n792\t\t\treturn \"\"\n793\t\t}\n794\t\n795\t\tif blocksFirst {\n796\t\t\tif s := tryBlocks(); s != \"\" {\n797\t\t\t\treturn s\n798\t\t\t}\n799\t\t\treturn tryString()\n800\t\t}\n801\t\tif s := tryString(); s != \"\" {\n802\t\t\treturn s\n803\t\t}\n804\t\treturn tryBlocks()\n805\t}\n806\t\n807\tfunc extractUserPrompt(content json.RawMessage) string {\n808\t\tif len(content) == 0 {\n809\t\t\treturn \"\"\n810\t\t}\n811\t\n812\t\tvar promptContent kiroPromptContent\n813\t\tif err := json.Unmarshal(content, &promptContent); err == nil && promptContent.Prompt.Prompt != \"\" {\n814\t\t\treturn promptContent.Prompt.Prompt\n815\t\t}\n816\t\treturn \"\"\n817\t}\n818\t\n819\tfunc extractModifiedFilesFromHistory(entries []kiroHistoryEntry) []string {\n820\t\tseen := make(map[string]bool)\n821\t\tvar files []string\n822\t\n823\t\tfor i := range entries {\n824\t\t\tfor _, path := range extractFilesFromAssistant(entries[i].Assistant) {\n825\t\t\t\tif path == \"\" || seen[path] {\n826\t\t\t\t\tcontinue\n827\t\t\t\t}\n828\t\t\t\tseen[path] = true\n829\t\t\t\tfiles = append(files, path)\n830\t\t\t}\n831\t\t}\n832\t\n833\t\treturn files\n834\t}\n835\t\n836\tfunc extractFilesFromAssistant(raw json.RawMessage) []string {\n837\t\tif len(raw) == 0 {\n838\t\t\treturn nil\n839\t\t}\n840\t\n841\t\tvar toolUseContent kiroToolUseContent\n842\t\tif err := json.Unmarshal(raw, &toolUseContent); err != nil || len(toolUseContent.ToolUse.ToolUses) == 0 {\n843\t\t\treturn nil\n844\t\t}\n845\t\n846\t\tvar paths []string\n847\t\tfor _, call := range toolUseContent.ToolUse.ToolUses {\n848\t\t\tif !isFileModificationTool(call.Name) {\n849\t\t\t\tcontinue\n850\t\t\t}\n851\t\t\tif path := extractFilePath(call.Args); path != \"\" {\n852\t\t\t\tpaths = append(paths, path)\n853\t\t\t}\n854\t\t}\n855\t\treturn paths\n856\t}\n857\t\n858\tfunc isFileModificationTool(name string) bool {\n859\t\t_, ok := kiroFileModificationTools[name]\n860\t\treturn ok\n861\t}\n862\t\n863\tfunc extractFilePath(args json.RawMessage) string {\n864\t\tif len(args) == 0 {\n865\t\t\treturn \"\"\n866\t\t}\n867\t\n868\t\tvar fields map[string]json.RawMessage\n869\t\tif err := json.Unmarshal(args, &fields); err != nil {\n870\t\t\treturn \"\"\n871\t\t}\n872\t\n873\t\tfor _, key := range []string{\"path\", \"file_path\", \"filename\", \"file\"} {\n874\t\t\traw, ok := fields[key]\n875\t\t\tif !ok {\n876\t\t\t\tcontinue\n877\t\t\t}\n878\t\t\tvar path string\n879\t\t\tif err := json.Unmarshal(raw, &path); err == nil && path != \"\" {\n880\t\t\t\treturn path\n881\t\t\t}\n882\t\t}\n883\t\treturn \"\"\n884\t}\n885\t\n886\tfunc extractLastAssistantResponse(entries []kiroHistoryEntry) string {\n887\t\tfor i := len(entries) - 1; i >= 0; i-- {\n888\t\t\tif len(entries[i].Assistant) == 0 {\n889\t\t\t\tcontinue\n890\t\t\t}\n891\t\n892\t\t\tvar responseContent kiroResponseContent\n893\t\t\tif err := json.Unmarshal(entries[i].Assistant, &responseContent); err == nil && responseContent.Response.Content != \"\" {\n894\t\t\t\treturn responseContent.Response.Content\n895\t\t\t}\n896\t\t}\n897\t\treturn \"\"\n898\t}\n899\t\n900\t// --- Execution log enrichment ---\n901\t\n902\t// extractIDESessionID parses the sessionId from an IDE session JSON file.\n903\tfunc extractIDESessionID(data []byte) string {\n904\t\tvar meta kiroIDESessionMeta\n905\t\tif err := json.Unmarshal(data, &meta); err != nil {\n906\t\t\treturn \"\"\n907\t\t}\n908\t\treturn meta.SessionID\n909\t}\n910\t\n911\t// extractIDEExecutionIDs parses executionId values from assistant entries\n912\t// in an IDE session JSON file.\n913\tfunc extractIDEExecutionIDs(data []byte) []string {\n914\t\tvar meta kiroIDESessionMeta\n915\t\tif err := json.Unmarshal(data, &meta); err != nil {\n916\t\t\treturn nil\n917\t\t}\n918\t\tvar ids []string\n919\t\tfor _, entry := range meta.History {\n920\t\t\tif entry.ExecutionID != \"\" {\n921\t\t\t\tids = append(ids, entry.ExecutionID)\n922\t\t\t}\n923\t\t}\n924\t\treturn ids\n925\t}\n926\t\n927\t// findExecutionLogsForSession scans Kiro IDE workspace directories to find\n928\t// execution log files matching the given chat session ID. Returns a map of\n929\t// executionId → *kiroExecutionLog.\n930\tfunc findExecutionLogsForSession(chatSessionID string) (map[string]*kiroExecutionLog, error) {\n931\t\tbaseDir, err := kiroExtensionStorageDir()\n932\t\tif err != nil {\n933\t\t\treturn nil, err\n934\t\t}\n935\t\n936\t\tentries, err := os.ReadDir(baseDir)\n937\t\tif err != nil {\n938\t\t\treturn nil, err\n939\t\t}\n940\t\n941\t\tfor _, entry := range entries {\n942\t\t\tif !entry.IsDir() || len(entry.Name()) != 32 {\n943\t\t\t\tcontinue\n944\t\t\t}\n945\t\t\tlogsDir := filepath.Join(baseDir, entry.Name(), execLogsSubdir)\n946\t\t\tif _, err := os.Stat(logsDir); err != nil {\n947\t\t\t\tcontinue\n948\t\t\t}\n949\t\t\tlogs := scanExecutionLogsDir(logsDir, chatSessionID)\n950\t\t\tif len(logs) > 0 {\n951\t\t\t\treturn logs, nil\n952\t\t\t}\n953\t\t}\n954\t\n955\t\treturn map[string]*kiroExecutionLog{}, nil\n956\t}\n957\t\n958\t// scanExecutionLogsDir reads all execution log files in a directory and returns\n959\t// those matching the given chat session ID.\n960\tfunc scanExecutionLogsDir(dir string, chatSessionID string) map[string]*kiroExecutionLog {\n961\t\tfiles, err := os.ReadDir(dir)\n962\t\tif err != nil {\n963\t\t\treturn nil\n964\t\t}\n965\t\n966\t\t// Two-pass approach: first identify matching files using a lightweight\n967\t\t// struct (avoids deserializing the large Actions array), then fully\n968\t\t// parse only the matches.\n969\t\tvar matchingPaths []string\n970\t\tfor _, f := range files {\n971\t\t\tif f.IsDir() {\n972\t\t\t\tcontinue\n973\t\t\t}\n974\t\t\tpath := filepath.Join(dir, f.Name())\n975\t\t\tdata, err := os.ReadFile(path)\n976\t\t\tif err != nil {\n977\t\t\t\tcontinue\n978\t\t\t}\n979\t\t\tvar header struct {\n980\t\t\t\tChatSessionID string `json:\"chatSessionId\"`\n981\t\t\t}\n982\t\t\tif json.Unmarshal(data, &header) == nil && header.ChatSessionID == chatSessionID {\n983\t\t\t\tmatchingPaths = append(matchingPaths, path)\n984\t\t\t}\n985\t\t}\n986\t\n987\t\tif len(matchingPaths) == 0 {\n988\t\t\treturn nil\n989\t\t}\n990\t\n991\t\tresult := make(map[string]*kiroExecutionLog, len(matchingPaths))\n992\t\tfor _, path := range matchingPaths {\n993\t\t\tdata, err := os.ReadFile(path)\n994\t\t\tif err != nil {\n995\t\t\t\tcontinue\n996\t\t\t}\n997\t\t\tvar log kiroExecutionLog\n998\t\t\tif err := json.Unmarshal(data, &log); err != nil {\n999\t\t\t\tcontinue\n1000\t\t\t}\n1001\t\t\tresult[log.ExecutionID] = &log\n1002\t\t}\n1003\t\treturn result\n1004\t}\n1005\t\n1006\t// convertExecutionActionsToHistoryEntries converts